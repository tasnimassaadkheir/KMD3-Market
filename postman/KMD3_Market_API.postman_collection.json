    {
      "name": "5. Segurança (security checks)",
      "description": "These requests send **no login token**. They prove Row Level Security is protecting the data: nobody without a login should see or change anything.",
      "item": [
        {
          "name": "List condos WITHOUT login",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{supabase_key}}"
              }
            ],
            "url": {
              "raw": "{{supabase_url}}/rest/v1/condominios?select=id,nome",
              "host": [
                "{{supabase_url}}"
              ],
              "path": [
                "rest",
                "v1",
                "condominios"
              ],
              "query": [
                {
                  "key": "select",
                  "value": "id,nome"
                }
              ]
            },
            "description": "Must return an empty list or an error, never real data."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"No data leaked\", () => {",
                  "  if (pm.response.code === 200) pm.expect(pm.response.json()).to.eql([]);",
                  "  else pm.expect(pm.response.code).to.be.oneOf([401,403]);",
                  "});"
                ]
